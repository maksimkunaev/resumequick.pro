FLASK_ENV=development
HOST=0.0.0.0
PORT=8000

# Daily credit allowance per user (required)
DAILY_FREE_CREDITS=9999

# LLM (Groq is used by default; OpenAI is optional)
GROQ_API_KEY=
OPENAI_API_KEY=

# Firebase Admin: path to the service account JSON. Leave commented out to use
# ./serviceAccountKey.json (an empty value would break the default).
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Static files: use absolute paths
STATIC_FOLDER=/absolute/path/to/resumequick.pro/frontend/build
STATIC_URL_PATH=/
SECOND_STATIC_FOLDER=/absolute/path/to/resumequick.pro/static

# Optional: feedback email (feature_services/send_feedback_service.py)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
FEEDBACK_EMAIL_TO=
